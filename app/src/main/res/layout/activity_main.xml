<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rmgBg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/rmgBg"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        app:title="RMG"
        app:titleTextColor="?attr/rmgText"
        app:subtitle="S918N  /  RMG CONTROL"
        app:subtitleTextColor="?attr/rmgMuted" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/rmgPanel"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hero"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:src="@drawable/ic_dfroot"
                            android:contentDescription="DFRoot shield symbol" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="RMG"
                                android:textColor="?attr/rmgText"
                                android:textSize="24sp"
                                android:fontFamily="sans-serif-medium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="GALAXY S23 ULTRA  •  KOREAN"
                                android:letterSpacing="0.09"
                                android:textColor="?attr/rmgIce"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="ROOT SESSION"
                        android:textColor="?attr/rmgIce"
                        android:letterSpacing="0.18"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_status"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="NOT ACTIVE"
                        android:letterSpacing="0.06"
                        android:textColor="?attr/rmgIce"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Experimental root environment. Compatibility depends on your exact firmware."
                        android:textColor="?attr/rmgSecondary"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressRoot"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="18dp"
                        android:visibility="gone"
                        app:indicatorColor="?attr/rmgCyan"
                        app:trackColor="?attr/rmgBorder"
                        app:indeterminateAnimationType="disjoint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="COMMAND CENTER"
                    android:textColor="?attr/rmgText"
                    android:letterSpacing="0.12"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01 / ACTIONS"
                    android:textColor="?attr/rmgMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/rmgPanel"
                app:strokeColor="?attr/rmgBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRun"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:text="START ROOT SESSION"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="?attr/rmgBg"
                        app:backgroundTint="?attr/rmgCyan"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManager"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:text="KERNELSU NEXT MANAGER"
                        android:textColor="?attr/rmgText"
                        android:textSize="13sp"
                        app:backgroundTint="?attr/rmgCardAlt"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchManualSoftReboot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Soft reboot after launch"
                        android:textSize="13sp"
                        android:textColor="?attr/rmgSecondary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Root may be temporary. Running this action changes kernel security state."
                        android:textColor="?attr/rmgMuted"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="DEVICE INTELLIGENCE"
                    android:textColor="?attr/rmgText"
                    android:letterSpacing="0.12"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="02 / SYSTEM"
                    android:textColor="?attr/rmgMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/rmgPanel"
                app:cardCornerRadius="22dp"
                app:strokeColor="?attr/rmgBorder"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="MODEL"
                        android:letterSpacing="0.1"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tvDeviceModel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Checking..."
                        android:textColor="?attr/rmgText"
                        android:textSize="17sp"
                        android:fontFamily="sans-serif-medium" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="?attr/rmgBorder" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BUILD / FIRMWARE"
                        android:letterSpacing="0.1"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tvDeviceBuild"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="—"
                        android:textColor="?attr/rmgText"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="?attr/rmgBorder" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="KERNEL"
                        android:letterSpacing="0.1"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tvKernel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="—"
                        android:textColor="?attr/rmgText"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="?attr/rmgBorder" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SELINUX"
                        android:letterSpacing="0.1"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/tvSelinux"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Unavailable"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AUTOMATION"
                    android:textColor="?attr/rmgText"
                    android:letterSpacing="0.12"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="03 / SETTINGS"
                    android:textColor="?attr/rmgMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/rmgPanel"
                app:strokeColor="?attr/rmgBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBootStart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Launch at device boot"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoSoftReboot"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Auto soft reboot at boot"
                        android:textColor="?attr/rmgSecondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LIVE CONSOLE"
                    android:textColor="?attr/rmgText"
                    android:letterSpacing="0.12"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:minWidth="70dp"
                    android:text="COPY"
                    android:textColor="?attr/rmgCyan"
                    android:textSize="11sp"
                    app:backgroundTint="?attr/rmgCardAlt"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="?attr/rmgConsole"
                app:strokeColor="?attr/rmgBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <ScrollView
                    android:id="@+id/outputScroll"
                    android:layout_width="match_parent"
                    android:layout_height="208dp"
                    android:fillViewport="true"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/outputView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="&gt; Session initialized.&#10;&gt; Awaiting user action."
                        android:textColor="?attr/rmgTerminal"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="4dp"
                        android:textIsSelectable="true" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="RMG  •  EXPERIMENTAL DFROOT BACKEND"
                android:textSize="10sp"
                android:letterSpacing="0.08"
                android:textColor="?attr/rmgMuted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>