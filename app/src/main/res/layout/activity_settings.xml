<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/rmgBg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/rmgBg"
        app:title="RMG SETTINGS"
        app:titleTextColor="?attr/rmgText"
        app:subtitle="CUSTOMIZATION / MANAGER"
        app:subtitleTextColor="?attr/rmgMuted" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="36dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THEME COLLECTION"
                android:textColor="?attr/rmgIce"
                android:textSize="12sp"
                android:letterSpacing="0.13"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Six expertly curated palettes. Your choice applies across both screens immediately."
                android:textColor="?attr/rmgSecondary"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/rmgPanel"
                app:strokeColor="?attr/rmgBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <RadioGroup
                    android:id="@+id/themeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/themeObsidian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:buttonTint="?attr/rmgCyan"
                        android:text="01  OBSIDIAN   /   DARK CYAN"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="36dp"
                        android:paddingBottom="12dp"
                        android:text="Midnight glass • vivid cyan"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="12sp" />
                    <RadioButton
                        android:id="@+id/themeAurora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:buttonTint="?attr/rmgCyan"
                        android:text="02  AURORA   /   PURPLE"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="36dp"
                        android:paddingBottom="12dp"
                        android:text="Violet layers • soft mint"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="12sp" />
                    <RadioButton
                        android:id="@+id/themeGlacier"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:buttonTint="?attr/rmgCyan"
                        android:text="03  GLACIER   /   ICE BLUE"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="36dp"
                        android:paddingBottom="12dp"
                        android:text="Arctic glass • electric blue"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="12sp" />
                    <RadioButton
                        android:id="@+id/themeEmber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:buttonTint="?attr/rmgCyan"
                        android:text="04  EMBER   /   COPPER"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="36dp"
                        android:paddingBottom="12dp"
                        android:text="Warm graphite • copper glow"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="12sp" />
                    <RadioButton
                        android:id="@+id/themeMatrix"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:buttonTint="?attr/rmgCyan"
                        android:text="05  MATRIX   /   LIME"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="36dp"
                        android:paddingBottom="12dp"
                        android:text="Deep forest • neon lime"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="12sp" />
                    <RadioButton
                        android:id="@+id/themeGalaxy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:buttonTint="?attr/rmgCyan"
                        android:text="06  RMG HERITAGE   /   IVORY"
                        android:textColor="?attr/rmgText"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="36dp"
                        android:paddingBottom="12dp"
                        android:text="Inspired by Root My Galaxy • cream &amp; amber"
                        android:textColor="?attr/rmgMuted"
                        android:textSize="12sp" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="SU MANAGER"
                android:textColor="?attr/rmgIce"
                android:textSize="12sp"
                android:letterSpacing="0.13"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="?attr/rmgPanel"
                app:strokeColor="?attr/rmgBorder"
                app:strokeWidth="1dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Choose an installed-compatible Manager"
                        android:textColor="?attr/rmgText"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium" />
                    <RadioGroup
                        android:id="@+id/managerGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">
                        <RadioButton
                            android:id="@+id/radioNext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:buttonTint="?attr/rmgCyan"
                            android:text="KernelSU Next"
                            android:textSize="15sp"
                            android:textColor="?attr/rmgText" />
                        <RadioButton
                            android:id="@+id/radioClassic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="50dp"
                            android:buttonTint="?attr/rmgCyan"
                            android:text="KernelSU Classic (Samsung)"
                            android:textSize="15sp"
                            android:textColor="?attr/rmgText" />
                    </RadioGroup>
                    <TextView
                        android:id="@+id/tvManagerStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Detecting manager..."
                        android:textColor="?attr/rmgIce"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/tvBackendNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Checking root backend..."
                        android:textColor="?attr/rmgSecondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOfflineInstall"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="18dp"
                        android:text="INSTALL MANAGER OFFLINE"
                        android:textColor="?attr/rmgBg"
                        android:fontFamily="sans-serif-medium"
                        app:backgroundTint="?attr/rmgCyan"
                        app:cornerRadius="16dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Both official Manager APKs are bundled with RMG and SHA-256 verified before installation. Android confirmation is always required."
                        android:textColor="?attr/rmgMuted"
                        android:gravity="center"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="RMG  /  EXPLORATORY ROOT TOOL  /  S918N"
                android:textColor="?attr/rmgMuted"
                android:letterSpacing="0.05"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>